cat > spec/javascript/admin_behaviours.test.js <<'JS'
const path = require("path");
const {
  KEYCODES,
  shouldVisitRow,
  popoverStateFor,
  createSelect
} = require(path.join(process.cwd(), "app/javascript/admin_behaviours"));

// Translated from administrate's spec/features/index_page_spec.rb
describe("shouldVisitRow", () => {
  const row = { type: "click", dataUrl: "/admin/widgets/1" };

  test("follows a clicked row", () => expect(shouldVisitRow(row)).toBe(true));
  test("follows on space", () =>
    expect(shouldVisitRow({ keyCode: KEYCODES.space, dataUrl: "/x" })).toBe(true));
  test("follows on enter", () =>
    expect(shouldVisitRow({ keyCode: KEYCODES.enter, dataUrl: "/x" })).toBe(true));
  test("ignores other keys", () =>
    expect(shouldVisitRow({ keyCode: 27, dataUrl: "/x" })).toBe(false));
  test("defers to a link inside the row", () =>
    expect(shouldVisitRow({ ...row, targetIsLink: true })).toBe(false));
  test("does not navigate while text is selected", () =>
    expect(shouldVisitRow({ ...row, selectionLength: 12 })).toBe(false));
  test("does nothing without a url", () =>
    expect(shouldVisitRow({ type: "click" })).toBe(false));
});

// Translated from administrate's spec/features/search_spec.rb tooltip coverage
describe("popoverStateFor", () => {
  test("opens on mouseenter", () => expect(popoverStateFor("mouseenter", "closed")).toBe("open"));
  test("closes on mouseleave", () => expect(popoverStateFor("mouseleave", "open")).toBe("closed"));
  test("leaves other events alone", () => expect(popoverStateFor("click", "open")).toBe("open"));
});

// Translated from administrate's spec/features/edit_page_spec.rb
describe("createSelect", () => {
  test("keeps its value through enhancement and teardown", () => {
    const select = createSelect("hardware");
    select.connect();
    select.choose("tooling");
    expect(select.disconnect()).toBe("tooling");
    expect(select.value).toBe("tooling");
  });

  test("can be connected twice without losing the value", () => {
    const select = createSelect("hardware");
    select.connect();
    select.connect();
    expect(select.enhanced).toBe(true);
    expect(select.value).toBe("hardware");
  });

  test("can be disconnected twice", () => {
    const select = createSelect("hardware");
    select.connect();
    select.disconnect();
    expect(() => select.disconnect()).not.toThrow();
    expect(select.enhanced).toBe(false);
  });
});
JS

mkdir -p spec/jasmine
cat > spec/jasmine/admin_behaviours_spec.js <<'JS'
const path = require("path");
const {
  KEYCODES,
  shouldVisitRow,
  popoverStateFor,
  createSelect
} = require(path.join(process.cwd(), "app/javascript/admin_behaviours"));

// The same coverage as the jest suite, in jasmine. Duplication is the point:
// both runners have to keep working once oubliette has moved them apart.
describe("shouldVisitRow", function () {
  it("follows a clicked row", function () {
    expect(shouldVisitRow({ type: "click", dataUrl: "/admin/widgets/1" })).toBe(true);
  });

  it("follows on space and enter", function () {
    expect(shouldVisitRow({ keyCode: KEYCODES.space, dataUrl: "/x" })).toBe(true);
    expect(shouldVisitRow({ keyCode: KEYCODES.enter, dataUrl: "/x" })).toBe(true);
  });

  it("defers to a link inside the row", function () {
    expect(shouldVisitRow({ type: "click", dataUrl: "/x", targetIsLink: true })).toBe(false);
  });

  it("does not navigate while text is selected", function () {
    expect(shouldVisitRow({ type: "click", dataUrl: "/x", selectionLength: 4 })).toBe(false);
  });

  it("does nothing without a url", function () {
    expect(shouldVisitRow({ type: "click" })).toBe(false);
  });
});

describe("popoverStateFor", function () {
  it("opens on mouseenter", function () {
    expect(popoverStateFor("mouseenter", "closed")).toBe("open");
  });

  it("closes on mouseleave", function () {
    expect(popoverStateFor("mouseleave", "open")).toBe("closed");
  });
});

describe("createSelect", function () {
  it("keeps its value through enhancement and teardown", function () {
    const select = createSelect("hardware");
    select.connect();
    select.choose("tooling");
    expect(select.disconnect()).toBe("tooling");
  });

  it("survives a second connect", function () {
    const select = createSelect("hardware");
    select.connect();
    select.connect();
    expect(select.value).toBe("hardware");
  });
});
JS

