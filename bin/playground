require "net/http"

RSpec.describe "the stock feed" do
  it "reads the quantity from the recorded cassette" do
    VCR.use_cassette("stock_feed") do
      body = Net::HTTP.get(URI("https://example.test/stock.json"))

      expect(JSON.parse(body)["quantity"]).to eq(42)
    end
  end
