cat > test/models/widget_test.rb <<'RUBY'
require "test_helper"

class WidgetTest < ActiveSupport::TestCase
  test "loads the relocated fixtures" do
    assert_equal "Bracket", widgets(:bracket).name
  end

  test "knows what needs restocking" do
    assert widgets(:grommet).restock?
    assert_not widgets(:bracket).restock?
  end

  test "requires a name" do
    assert_not Widget.new(quantity: 1, category: categories(:hardware)).valid?
  end
end
RUBY

cat > test/controllers/widgets_controller_test.rb <<'RUBY'
require "test_helper"

class WidgetsControllerTest < ActionDispatch::IntegrationTest
  test "index" do
    get widgets_url
    assert_response :success
    assert_match widgets(:bracket).name, response.body
  end

  test "create" do
    assert_difference "Widget.count", 1 do
      post widgets_url, params: {
        widget: { name: "Shim", quantity: 4, available: true, category_id: categories(:hardware).id }
      }
    end
  end
end
