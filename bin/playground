#!/usr/bin/env bash
# Builds a durable Rails application to try oubliette against by hand: real CRUD,
# real JavaScript, and one passing test per framework oubliette knows about.
#
# It stops before migrating anything. Everything is green and in its default
# location, so `rake oubliette` is yours to run, break, and roll back.
set -euo pipefail

unset BUNDLE_GEMFILE BUNDLE_PATH BUNDLE_BIN_PATH RUBYOPT || true
export RBENV_VERSION="${RBENV_VERSION:-3.4.1}"

GEM_DIR="$(cd "$(dirname "$0")/.." && pwd)"
export GEM_DIR
APP="${1:-$HOME/developer/Projects/oubliette-playground}"

rm -rf "$APP"
mkdir -p "$(dirname "$APP")"

echo "==> rails new"
(cd "$(dirname "$APP")" && rails new "$(basename "$APP")" \
  --skip-bootsnap --skip-kamal --skip-solid --skip-ci --skip-docker \
  --skip-jbuilder --skip-brakeman --skip-rubocop --quiet)

cd "$APP"

cat >> Gemfile <<'RUBY'

# Uncomment, then `bundle install`, to install oubliette and get its rake tasks.
# Everything below is already installed and green without it.
# OUBLIETTE_LINE_PLACEHOLDER

group :development, :test do
  gem "rspec-rails"
  gem "factory_bot_rails"
end

# An engine with its own javascript, so there is something real for the browser
# specs to drive and for oubliette to leave alone.
gem "administrate", "~> 1.0"

# capybara and selenium-webdriver are not listed: rails 8 already ships both in
# a test group of its own, and declaring them twice makes bundler say so on
# every single run.
group :test do
  gem "cucumber-rails", require: false
  gem "database_cleaner-active_record"
  gem "simplecov", require: false
  gem "vcr"
  gem "webmock"
end
RUBY
# A checkout of the gem is pointed at by path so edits take effect immediately.
# An installed copy lives somewhere no Gemfile should ever name, so it is
# declared by version like any other dependency.
if [ -f "$GEM_DIR/oubliette.gemspec" ]; then
  OUBLIETTE_LINE="gem \"oubliette\", path: \"$GEM_DIR\""
else
  OUBLIETTE_LINE="gem \"oubliette\", \"~> $(ruby -r "$GEM_DIR/lib/oubliette/version" -e 'print Oubliette::VERSION')\""
fi
export OUBLIETTE_LINE
ruby -i -pe "sub(%r{OUBLIETTE_LINE_PLACEHOLDER}, ENV.fetch('OUBLIETTE_LINE'))" Gemfile

echo "==> bundle install"
bundle install --quiet

echo "==> CRUD"
bin/rails generate scaffold Category name:string --quiet
bin/rails generate scaffold Widget name:string quantity:integer available:boolean category:references --quiet
bin/rails db:prepare

ruby -i -pe 'sub(/^end$/, "  belongs_to :category\n\n  validates :name, presence: true\n  validates :quantity, numericality: { greater_than_or_equal_to: 0 }\n\n  def restock?\n    quantity < 5\n  end\nend")' app/models/widget.rb
ruby -i -pe 'sub(/^end$/, "  has_many :widgets, dependent: :destroy\n\n  validates :name, presence: true\nend")' app/models/category.rb
echo "==> administrate"
bin/rails generate administrate:install --quiet 2>&1 | grep -v "^WARNING\|^       -\|^         " || true

# Administrate labels a record "Category #<id>" unless the dashboard says
# otherwise, and that label is what the belongs_to dropdown shows.
for pair in "category_dashboard:category" "widget_dashboard:widget"; do
  file="app/dashboards/${pair%%:*}.rb"; arg="${pair##*:}"
  ARG="$arg" ruby -i -e '
    body = ARGF.read
    arg = ENV.fetch("ARG")
    addition = "\n  # Without this administrate shows \"Model #<id>\" wherever a record is\n" \
               "  # named, including inside the belongs_to dropdown.\n" \
               "  def display_resource(#{arg})\n    #{arg}.name\n  end\n"
    print body.sub(/\nend\s*\z/, addition + "end\n")
  ' "$file"
  grep -q "def display_resource" "$file" || { echo "failed to patch $file"; exit 1; }
done

# The filter tooltip only renders when the dashboard declares filters, and the
# tooltip is one of the three stimulus controllers worth covering.
ruby -i -pe 'sub(/^  COLLECTION_FILTERS = \{\}\.freeze$/, %q{  COLLECTION_FILTERS = {
    available: ->(resources) { resources.where(available: true) }
  }.freeze})' app/dashboards/widget_dashboard.rb

# The scaffold generators write their own specs, factories and tests. Clear them
# out so the ones written further down are the only ones in the app -- two
# `factory :category` definitions is an error, not a merge.
rm -rf spec
rm -f test/models/*_test.rb test/controllers/*_test.rb test/fixtures/*.yml

# The scaffold renders a belongs_to as a bare id field. A dropdown is both nicer
# to click and what `select "Hardware", from: "Category"` needs to find.
ruby -i -pe 'sub(%r{form\.(text_field|number_field) :category_id}, %q{form.collection_select :category_id, Category.order(:name), :id, :name})' app/views/widgets/_form.html.erb
grep -q "collection_select :category_id" app/views/widgets/_form.html.erb || {
  echo "the category field was not converted to a select -- the scaffold template changed"
  exit 1
}

ruby -i -pe 'sub(%r{^  root .*$}, "")' config/routes.rb
ruby -i -pe 'sub(/^end$/, "  root \"widgets#index\"\nend")' config/routes.rb

echo "==> javascript"
mkdir -p app/javascript
cat > app/javascript/restock.js <<'JS'
// Plain CommonJS so jest runs it with no transform, and so a script tag can
// load it in the browser without a build step.
function restockLevel(quantity, threshold) {
  if (typeof quantity !== "number" || Number.isNaN(quantity)) return "unknown";
  if (quantity <= 0) return "out";
  if (quantity < threshold) return "low";
  return "ok";
}

function totalQuantity(widgets) {
  return widgets.reduce(function (sum, widget) {
    return sum + (widget.quantity || 0);
  }, 0);
}

if (typeof window !== "undefined") {
  window.restockLevel = restockLevel;
  window.totalQuantity = totalQuantity;
}

if (typeof module !== "undefined" && module.exports) {
  module.exports = { restockLevel: restockLevel, totalQuantity: totalQuantity };
}
JS

cat > app/javascript/admin_behaviours.js <<'JS'
// The rules administrate's stimulus controllers embody, written out so they can
// be checked headlessly by jest and by jasmine.
//
// The engine's real behaviour in a browser is covered by the capybara specs in
// spec/system/admin. These cover the same decisions without a browser, which is
// what makes them useful for proving the javascript suites still run after
// oubliette has moved them.
var KEYCODES = { space: 32, enter: 13 };

// table_controller#visitDataUrl
function shouldVisitRow(event) {
  var triggered =
    event.type === "click" ||
    event.keyCode === KEYCODES.space ||
    event.keyCode === KEYCODES.enter;

  if (!triggered) return false;
  if (event.targetIsLink) return false;
  if ((event.selectionLength || 0) > 0) return false;

  return Boolean(event.dataUrl);
}

// tooltip_controller
function popoverStateFor(eventType, current) {
  if (eventType === "mouseenter") return "open";
  if (eventType === "mouseleave") return "closed";
  return current;
}

// select_controller: the value has to survive being enhanced and torn down,
// and both halves are guarded so they can run twice without harm.
function createSelect(initialValue) {
  var value = initialValue;
  var enhanced = false;

  return {
    connect: function () {
      if (!enhanced) enhanced = true;
      return value;
    },
    choose: function (next) {
      value = next;
    },
    disconnect: function () {
      if (enhanced) enhanced = false;
      return value;
    },
    get value() {
      return value;
    },
    get enhanced() {
      return enhanced;
    }
  };
}

if (typeof window !== "undefined") {
  window.shouldVisitRow = shouldVisitRow;
  window.popoverStateFor = popoverStateFor;
}

if (typeof module !== "undefined" && module.exports) {
  module.exports = {
    KEYCODES: KEYCODES,
    shouldVisitRow: shouldVisitRow,
    popoverStateFor: popoverStateFor,
    createSelect: createSelect
  };
}
JS

cat > app/javascript/counter.js <<'JS'
document.addEventListener("click", function (event) {
  var button = event.target.closest("[data-counter-step]");
  if (!button) return;

  var output = document.getElementById("counter-value");
  var step = parseInt(button.dataset.counterStep, 10);
  var next = parseInt(output.textContent, 10) + step;

  output.textContent = next;
  document.getElementById("counter-status").textContent =
    window.restockLevel ? window.restockLevel(next, 5) : "unknown";
});
JS

ruby -i -pe 'sub(%r{<%= javascript_importmap_tags %>}, %q{<%= javascript_importmap_tags %>\n    <%= javascript_include_tag "restock", "counter", defer: true %>})' app/views/layouts/application.html.erb

cat >> app/views/widgets/index.html.erb <<'ERB'

<section id="counter" style="margin-top:2rem">
  <h2>Stock counter</h2>
  <p>Quantity: <span id="counter-value">5</span> &mdash; <span id="counter-status">ok</span></p>
  <button data-counter-step="1">Add one</button>
  <button data-counter-step="-1">Remove one</button>
</section>
ERB

