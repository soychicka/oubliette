# ---------- cucumber ----------
cat > features/widgets.feature <<'GHERKIN'
Feature: Widgets
  Scenario: adding a widget
    Given a category called "Hardware"
    When I add the widget "Cog" with 9 in stock
    Then I should see "Cog" in the widget list

  Scenario: spotting a widget that needs restocking
    Given a category called "Hardware"
    When I add the widget "Washer" with 2 in stock
    Then the widget "Washer" should want restocking
GHERKIN

cat > features/step_definitions/widget_steps.rb <<'RUBY'
Given("a category called {string}") do |name|
  @category = Category.create!(name: name)
end

When("I add the widget {string} with {int} in stock") do |name, quantity|
  visit new_widget_path
  fill_in "Name", with: name
  fill_in "Quantity", with: quantity.to_s
  select @category.name, from: "Category"
  click_on "Create Widget"
end

Then("I should see {string} in the widget list") do |name|
  visit widgets_path
  expect(page).to have_text(name)
end

Then("the widget {string} should want restocking") do |name|
  expect(Widget.find_by!(name: name)).to be_restock
end
RUBY

