# ---------- simplecov, so coverage/ exists ----------
ruby -e '
  path = "spec/spec_helper.rb"
  body = File.read(path)
  File.write(path, %(require "simplecov"\nSimpleCov.start "rails" do\n  enable_coverage :branch\nend\n\n) + body)
'

echo "run 'bin/verify' to see every suite pass" > test_results/README.txt

# ---------- one command to run everything ----------
cat > bin/verify <<'VERIFY'
#!/usr/bin/env bash
# Runs every suite this application has. Break something, then run it again.
set -uo pipefail
cd "$(dirname "$0")/.."

failed=0
run() {
  echo
  echo "----- $1 -----"
  shift
  if "$@"; then echo "PASS"; else echo "FAIL"; failed=1; fi
}

run "rspec"    bundle exec rspec
run "cucumber" bundle exec cucumber --format progress
run "minitest" bin/rails test
# npm test, not a hardcoded path: oubliette rewrites the script in package.json,
# so this keeps working after the javascript directory moves.
run "jest"     npm run test:jest --silent
run "jasmine"  npm run test:jasmine --silent

echo
if [ "$failed" -eq 0 ]; then echo "everything green"; else echo "something failed"; exit 1; fi
VERIFY
chmod +x bin/verify

echo "==> npm install"
npm install --silent --no-audit --no-fund

# SimpleCov writes coverage/ on every run and Rails does not ignore it. Left
# untracked it would block `rake oubliette`, which refuses to move anything while
# the tree has work git has not been told about. The trailing slash matches the
# directory wherever it ends up, including test/results/coverage after a move.
cat >> .gitignore <<'IGNORE'

coverage/
node_modules/
tmp/capybara/
IGNORE

git add -A
git -c user.email=playground@example.com -c user.name=playground commit -qm "Playground before oubliette"

echo "==> verifying every suite is green"
bin/verify

echo
echo "==> and again, because a suite that only passes on a fresh database is a trap"
bin/verify

echo
echo "==> ready at $APP -- green, and oubliette is NOT installed yet"
echo
echo "    bin/verify                             every suite, before anything moves"
echo
echo "  to demo the install:"
echo "    uncomment the oubliette line in Gemfile"
echo "    bundle install"
echo "    git commit -am 'install oubliette'   # optional; the Gemfile no longer blocks it"
echo "    bundle exec rake oubliette:dry_run     see what it would do"
echo "    bundle exec rake oubliette             do it"
echo "    bin/verify                             every suite, after"
echo "    bundle exec rake oubliette:rollback    put it all back"
