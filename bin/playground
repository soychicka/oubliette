cat > spec/support/webdrivers.rb <<'RUBY'
# Adapted from administrate's own spec/support/webdrivers.rb. Specs tagged :js
# get a real browser, so the engine's stimulus controllers actually run.
#
# Administrate pins Capybara.server to webrick, which ruby 3.4 no longer bundles;
# capybara's default is puma, which this application already runs.
require "selenium/webdriver"

Capybara.register_driver :headless_chrome do |app|
  options = ::Selenium::WebDriver::Chrome::Options.new
  options.add_argument "--headless=new"
  options.add_argument "--window-size=1680,1050"
  options.add_argument "--disable-gpu"
  options.add_argument "--disable-dev-shm-usage"
  options.add_argument "--no-sandbox"

  Capybara::Selenium::Driver.new(app, browser: :chrome, options: options)
end

Capybara.javascript_driver = :headless_chrome

RSpec.configure do |config|
  config.before(:each, type: :system) { driven_by :rack_test }
  config.before(:each, type: :system, js: true) { driven_by Capybara.javascript_driver }
end
RUBY

# ---------- administrate, driven in a real browser ----------
mkdir -p spec/system/admin

cat > spec/system/admin/index_page_spec.rb <<'RUBY'
require "rails_helper"

# Ported from administrate's spec/features/index_page_spec.rb. Drives the
# engine's table_controller: the whole row is clickable, but not when the click
# landed on a link.
RSpec.describe "admin widget index", type: :system do
  it "renders the table without javascript" do
    widget = create(:widget, name: "Bracket")

    visit admin_widgets_path

    expect(page).to have_css("table[data-controller='table']")
    expect(page).to have_css("tr.js-table-row[data-url]")
    expect(page).to have_content(widget.name)
  end

  it "follows the row to the show page", :js do
    widget = create(:widget, name: "Bracket")

    visit admin_widgets_path
    find("tr.js-table-row[data-url='#{admin_widget_path(widget)}']").click

    expect(page).to have_current_path(admin_widget_path(widget))
    expect(page).to have_content("Bracket")
  end

  it "follows a link inside the row rather than the row itself", :js do
    widget = create(:widget, name: "Bracket")

    visit admin_widgets_path
    within("tr.js-table-row") { click_on "Edit" }

    expect(page).to have_current_path(edit_admin_widget_path(widget))
  end
end
RUBY

cat > spec/system/admin/edit_page_spec.rb <<'RUBY'
require "rails_helper"

# Ported from administrate's spec/features/edit_page_spec.rb. Drives the
# engine's select_controller, which replaces the belongs_to select with a
# selectize widget on connect and writes the value back on disconnect.
RSpec.describe "admin widget form", type: :system do
  it "renders a plain select without javascript" do
    create(:category, name: "Hardware")
    widget = create(:widget)

    visit edit_admin_widget_path(widget)

    expect(page).to have_css("select[name='widget[category_id]']")
  end

  it "enhances the category select into a selectize dropdown", :js do
    create(:category, name: "Hardware")
    widget = create(:widget)

    visit edit_admin_widget_path(widget)

    expect(page).to have_css(".selectize-input")
  end

  it "selects a category through the dropdown and saves it", :js do
    hardware = create(:category, name: "Hardware")
    create(:category, name: "Tooling")
    widget = create(:widget, category: hardware)

    visit edit_admin_widget_path(widget)
    # selectize renders its dropdown at the end of body, not inside the field,
    # so the option is looked up from the page rather than within the wrapper.
    find(".field-unit--belongs-to .selectize-input").click
    find(".option", text: "Tooling").click
    click_on "Update Widget"

    expect(page).to have_content("Tooling")
    expect(widget.reload.category.name).to eq("Tooling")
  end
end
RUBY

cat > spec/system/admin/search_spec.rb <<'RUBY'
require "rails_helper"

# Ported from administrate's spec/features/search_spec.rb. The filter tooltip is
# the engine's tooltip_controller, driving the native popover API.
RSpec.describe "admin widget search", type: :system do
  # Searching prints a Rails 8.2 deprecation warning. It is not from this spec:
  # administrate-1.0.0/lib/administrate/search.rb:114 calls String#mb_chars, and
  # rails attributes the warning to the nearest application frame, which is the
  # visit below. 1.0.0 is the latest release, so there is no upgrade that fixes
  # it -- administrate's search will break on Rails 8.2. Left visible on purpose.
  it "finds a widget by name" do
    create(:widget, name: "Bracket")
    create(:widget, name: "Grommet")

    visit admin_widgets_path(search: "Bracket")

    expect(page).to have_content("Bracket")
    expect(page).not_to have_content("Grommet")
  end

  it "shows the filter tooltip button" do
    visit admin_widgets_path

    expect(page).to have_css("[data-controller='tooltip']")
  end

  it "opens the popover on hover and closes it again", :js do
    visit admin_widgets_path

    expect(page).to have_css("[data-tooltip-target='popover']", visible: :hidden)

    find("[data-tooltip-target='tooltip']").hover
    expect(page).to have_css("[data-tooltip-target='popover']", visible: :visible)

    find("h1, .main-content__page-title", match: :first).hover
    expect(page).to have_css("[data-tooltip-target='popover']", visible: :hidden)
  end
end
RUBY

